{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "expodia-flight",
  "main": "./cloudflare-worker.ts",
  "compatibility_date": "2026-09-27",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "expodia-flight"
    },
    {
      "binding": "EXPODIA_AGENTS",
      "service": "expodia-agents"
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
