# Production flight provider. Leave empty until an authorized provider is actually configured.
FLIGHT_PROVIDER_NAME=
FLIGHT_PROVIDER_API_BASE_URL=
FLIGHT_PROVIDER_API_KEY=

# Payment provider. Keep server-only; never use NEXT_PUBLIC_*.
PAYMENT_PROVIDER_NAME=
PAYMENT_PROVIDER_API_BASE_URL=
PAYMENT_PROVIDER_API_KEY=

# Notification providers. Keep credentials server-only.
EMAIL_PROVIDER_API_KEY=
SMS_PROVIDER_API_KEY=
WHATSAPP_PROVIDER_API_KEY=

# Transactional email (SendGrid) and RCS (Google RCS Business Messaging).
SENDGRID_API_KEY=
# Verified SendGrid sender address used as the From address.
NOTIFICATION_EMAIL_FROM=
GOOGLE_RBM_AGENT_ID=
# Full service-account JSON (single line) with the RCS Business Messaging scope.
GOOGLE_RBM_SERVICE_ACCOUNT_JSON=

# Browser push (Web Push / VAPID). Generate a pair with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@expodia.example

# Customer-facing travel intelligence (server-only; used for current web research in chat)
OPENAI_API_KEY=
EXPODIA_AI_MODEL=gpt-5.6-luna

# Aviation intelligence providers. Keep all credentials server-only.
FLIGHT_TRACKING_PROVIDER_NAME=
FLIGHT_TRACKING_PROVIDER_API_BASE_URL=
FLIGHT_TRACKING_PROVIDER_API_KEY=
AIRPORT_DATA_PROVIDER_NAME=
